# Server
PORT=4000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=change_me_session_secret
JWT_SECRET=change_me_jwt_secret

# Database (Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Ethereal (fake SMTP) - leave blank to auto-generate a test account on boot
ETHEREAL_USER=
ETHEREAL_PASS=

# Scheduler / rate limiting (all configurable, no hardcoding)
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
DEFAULT_SENDERS=sender1@reachinbox.test,sender2@reachinbox.test
